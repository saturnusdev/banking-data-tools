<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/" xmlns:fmt="http://www.ibm.com/dfdl/GeneralPurposeFormat" xmlns:ibmSchExtn="http://www.ibm.com/schema/extensions" xmlns:ref="http://www.ibm.com/dfdl/RecordFixLengthFieldFormat">
    <xsd:import namespace="http://www.ibm.com/dfdl/RecordFixLengthFieldFormat" schemaLocation="recordFixLengthFieldFormat.xsd"/>
    <xsd:simpleType dfdl:textStringJustification="right" dfdl:textStringPadCharacter="0" dfdl:textTrimKind="none" name="SIBS_General_Numeric_String">
        <xsd:restriction base="xsd:string"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:textNumberRounding="explicit" dfdl:textNumberRoundingIncrement="0.0" dfdl:textNumberRoundingMode="roundUnnecessary" name="SIBS-Zoned-Decimal__decimal">
        <xsd:restriction base="xsd:decimal"/>
    </xsd:simpleType>
    <xsd:simpleType name="SIBS-General-Filler__hexb">
        <xsd:restriction base="xsd:hexBinary"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:textStringJustification="right" dfdl:textStringPadCharacter="0" name="SIBS-General_Numeric__string">
        <xsd:restriction base="xsd:string"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:textNumberPattern="#" dfdl:textNumberRep="standard" name="SIBS-General-Numeric__int">
        <xsd:restriction base="xsd:nonNegativeInteger"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:lengthUnits="characters" name="SIBS-Unsigned-Zoned-Decimal__int">
        <xsd:restriction base="xsd:nonNegativeInteger"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:binaryNumberRep="binary" dfdl:representation="binary" name="SIBS-Binary-Numeric__int">
        <xsd:restriction base="xsd:integer"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:calendarPattern="yyyy-MM-dd-HH.mm.ss.SSSSSS" dfdl:calendarPatternKind="explicit" dfdl:length="26" dfdl:lengthUnits="characters" name="SIBS-Timestamp__datetime">
        <xsd:restriction base="xsd:dateTime"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:binaryNumberRep="packed" dfdl:representation="binary" name="SIBS-Packed-Decimal__int">
        <xsd:restriction base="xsd:integer"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:lengthKind="explicit" dfdl:lengthUnits="characters" dfdl:representation="text" name="SIBS-Signed-Zoned-Decimal__int">
        <xsd:restriction base="xsd:integer"/>
    </xsd:simpleType>
    <xsd:simpleType dfdl:lengthUnits="characters" name="SIBS-General-Text__string">
        <xsd:restriction base="xsd:string"/>
    </xsd:simpleType>
    <xsd:annotation>
        <xsd:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:format ref="ref:RecordFixLengthFieldsFormat"/>
        </xsd:appinfo>
    </xsd:annotation>
</xsd:schema>
